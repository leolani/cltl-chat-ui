# Standalone defaults for `python src/main.py`, i.e. running this component on
# its own with no deployment configuration mounted over it.
#
# The topic names here are the component's own LEGACY names. A real deployment
# (app/py-app/config/default.config, or the integration harness) supplies the
# platform-wide `cltl.topic.*` names by mounting its own config/ over this one.

[cltl.event]
implementation: internal

[cltl.chat-ui]
name: chat-ui
agent_id: leolani
external_input: False
# Minutes a chat is held for one browser; 0 disables the cookie entirely.
timeout: 0

# Image upload is off here on purpose. With `external_input: False`,
# `get_utterances` defaults the speaker filter to the agent's name, which
# filters the image echo straight back out of the transcript. Turn it on in a
# deployment that also sets `external_input: True`.
image_upload: False
image_cache: 4
image_max_size: 10485760
image_types: image/png, image/jpeg, image/gif, image/webp
# Where uploaded pixels are PUT so that `cltl-storage:image/<id>` resolves.
# Empty falls back to [cltl.backend] storage_url, which is what
# cltl-emissor-data resolves the same reference against.
image_storage_url:
image_upload_timeout: 30

# Where the browser reaches cltl-monitoring, for the Monitoring tab. Empty
# leaves the tab out: running this component on its own, there is nothing there.
monitoring_url:

[cltl.chat-ui.events]
local: True
topic_utterance: cltl.chat.utterance
topic_response: cltl.chat.response
topic_scenario: cltl.chat.scenario
topic_image: cltl.topic.image

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
type: direct
compression: bzip2
